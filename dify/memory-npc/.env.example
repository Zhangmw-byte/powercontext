# npc-memory 配置示例。
# 容器内由 compose.memory.yaml 注入；本机开发可直接 export 后运行 uvicorn。

# FastAPI 门面监听端口（容器内固定 8877）
NPC_MEMORY_HOST=0.0.0.0
NPC_MEMORY_PORT=8877

# 真实 PowerContext Server 地址。
# 容器内 entrypoint 会自行拉起 server 并把本变量设为 http://127.0.0.1:8878；
# 若使用外部独立部署的 PowerContext Server，则改成其地址。
POWERCONTEXT_SERVER_URL=http://127.0.0.1:8878

# PowerContext SQLite 数据目录（容器内挂载卷 /data；本机默认 ~/.local/share/powercontext）
# POWERCONTEXT_HOME=/data

# 送入模型的历史回合窗口上限；完整存档始终保留在 PowerContext 中
NPC_MEMORY_HISTORY_WINDOW=12

# 输入长度防护
NPC_MEMORY_MAX_ACTION_CHARS=2000
NPC_MEMORY_MAX_REPLY_CHARS=8000

# SDK 请求超时（秒）
NPC_MEMORY_TIMEOUT_SECONDS=30
